        {
          "name": "Scripts & tests",
          "folders": [],
          "items": [
            {
              "type": "request",
              "name": "Pre-request script sets a variable",
              "config": {
                "method": "GET",
                "url": "{{baseUrl}}/headers",
                "params": [],
                "headers": [
                  {
                    "key": "X-Sample-Request",
                    "value": "{{requestId}}",
                    "enabled": true
                  }
                ],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "http",
                "preRequestScript": "// Runs before the request is sent. Variables set here can be used as {{name}}.\njt.variables.requestId = \"req-\" + Date.now();\nconsole.log(\"Sending request\", jt.variables.requestId);",
                "testScript": "jt.test(\"header carried the generated id\", () => {\n  jt.expect(jt.response.json().headers[\"X-Sample-Request\"]).toContain(\"req-\");\n});"
              }
            },
            {
              "type": "request",
              "name": "Assertions on a JSON response",
              "config": {
                "method": "GET",
                "url": "{{jsonUrl}}/users/1",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "http",
                "testScript": "const user = jt.response.json();\n\njt.test(\"status is 200\", () => jt.expect(jt.response.status).toBe(200));\njt.test(\"has an id and name\", () => {\n  jt.expect(user).toHaveProperty(\"id\", 1);\n  jt.expect(user.name).toBeDefined();\n});\njt.test(\"email looks valid\", () => jt.expect(user.email).toContain(\"@\"));\njt.test(\"responds quickly\", () => jt.expect(jt.response.timings.durationMs).toBeLessThan(5000));\nconsole.log(\"User:\", user.name);"
              }
            },
            {
              "type": "request",
              "name": "A failing test (on purpose)",
              "config": {
                "method": "GET",
                "url": "{{baseUrl}}/status/418",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "http",
                "testScript": "jt.test(\"expects 200 — fails, the server replies 418\", () => {\n  jt.expect(jt.response.status).toBe(200);\n});\njt.test(\"is not a 404\", () => jt.expect(jt.response.status).not.toBe(404));"
              }
            },
            {
              "type": "request",
              "name": "A script written for Postman (pm.*)",
              "config": {
                "method": "GET",
                "url": "{{jsonUrl}}/users/1",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "testScript": "// Postman's common pm calls work as written.\npm.test(\"status is 200\", () => pm.response.to.have.status(200));\npm.test(\"the user has an email\", () => {\n  const user = pm.response.json();\n  pm.expect(user).to.have.property(\"email\");\n  pm.expect(user.email).to.be.a(\"string\").and.to.include(\"@\");\n});\npm.environment.set(\"userEmail\", pm.response.json().email);"
              }
            }
          ]
        },
