                "protocol": "http",
                "testScript": "jt.test(\"status is 200\", () => {\n  jt.expect(jt.response.status).toBe(200);\n});\n\njt.test(\"authenticated\", () => {\n  jt.expect(jt.response.json().authenticated).toBe(true);\n});"
