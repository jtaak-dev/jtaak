            "testScript": "// Runs again as events arrive: it passes once all five are in.\njt.test(\"five events arrive\", () => jt.expect(jt.messages.length).toBe(5));\njt.test(\"the first within 10 s\", () => jt.expect(jt.messages[0].at).toBeLessThan(10000));"
