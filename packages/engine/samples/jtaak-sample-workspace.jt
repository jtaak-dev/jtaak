    {
      "category": "messaging",
      "name": "Sample — Messaging",
      "folders": [
        {
          "name": "Public test brokers (work straight away)",
          "folders": [],
          "items": [
            {
              "type": "messaging",
              "name": "Mosquitto test broker (MQTT 3.1.1)",
              "protocol": "mqtt",
              "url": "mqtt://test.mosquitto.org:1883",
              "headers": [],
              "auth": {
                "type": "none"
              },
              "settings": {},
              "subscriptions": [
                {
                  "channel": "jtaak-sample/#"
                }
              ]
            },
            {
              "type": "messaging",
              "name": "Mosquitto over WebSocket and TLS (wss)",
              "protocol": "mqtt",
              "url": "wss://test.mosquitto.org:8081",
              "headers": [],
              "auth": {
                "type": "none"
              },
              "settings": {},
              "subscriptions": [
                {
                  "channel": "jtaak-sample/#",
                  "options": {
                    "qos": 1
                  }
                }
              ]
            },
            {
              "type": "messaging",
              "name": "HiveMQ public broker (MQTT 5)",
              "protocol": "mqtt",
              "url": "mqtt://broker.hivemq.com:1883",
              "headers": [],
              "auth": {
                "type": "none"
              },
              "settings": {
                "protocolVersion": 5
              },
              "subscriptions": [
                {
                  "channel": "jtaak-sample/#",
                  "options": {
                    "qos": 1
                  }
                }
              ]
            },
            {
              "type": "messaging",
              "name": "NATS demo server",
              "protocol": "nats",
              "url": "nats://demo.nats.io:4222",
              "headers": [],
              "auth": {
                "type": "none"
              },
              "settings": {},
              "subscriptions": [
                {
                  "channel": "jtaak.sample.>"
                }
              ]
            },
            {
              "type": "messaging",
              "name": "Mosquitto, with tests on what arrives",
              "protocol": "mqtt",
              "url": "mqtt://test.mosquitto.org:1883",
              "headers": [],
              "auth": {
                "type": "none"
              },
              "settings": {},
              "subscriptions": [
                {
                  "channel": "jt/sample/orders/#",
                  "options": {
                    "qos": 0
                  }
                }
              ],
              "testScript": "// Publish {\"status\":\"paid\"} to jt/sample/orders/1 on the Publish tab.\njt.test(\"an order is paid within 30 s\", () => {\n  const paid = jt.messages.find((m) => m.direction === \"received\" && m.json().status === \"paid\");\n  jt.expect(paid).toBeDefined();\n  jt.expect(paid.at).toBeLessThan(30000);\n});"
            }
          ]
        },
        {
