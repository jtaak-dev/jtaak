                  "type": "none"
                },
                "testScript": "jt.test(\"the cookie is kept\", () => jt.expect(jt.cookies.get(\"flavour\")).toBe(\"oatmeal\"));\njt.test(\"and sent after the redirect\", () => jt.expect(jt.response.json().cookies.flavour).toBe(\"oatmeal\"));"
              }
            },
            {
              "type": "request",
              "name": "Send the kept cookies",
              "config": {
                "method": "GET",
                "url": "https://httpbin.org/cookies",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "testScript": "jt.test(\"the kept cookie is sent\", () => jt.expect(jt.response.json().cookies.flavour).toBe(\"oatmeal\"));"
              }
            },
            {
              "type": "request",
              "name": "Without the cookie jar",
              "config": {
                "method": "GET",
                "url": "https://httpbin.org/cookies",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "useCookies": false,
                "testScript": "jt.test(\"no cookies are sent\", () => jt.expect(jt.response.json().cookies).toEqual({}));"
              }
            }
          ]
        }
      ],
      "items": []
    },
    {
      "category": "api",
      "name": "Sample — GraphQL",
      "folders": [
        {
          "name": "Countries API",
          "folders": [],
          "items": [
            {
              "type": "request",
              "name": "Simple query",
              "config": {
                "method": "POST",
                "url": "{{countriesGraphqlUrl}}",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "{\n  country(code: \"IN\") {\n    name\n    capital\n    currency\n    emoji\n  }\n}"
                },
                "testScript": "jt.test(\"returns India\", () => {\n  jt.expect(jt.response.json().data.country.name).toBe(\"India\");\n});"
              }
            },
            {
              "type": "request",
              "name": "Query with variables",
              "config": {
                "method": "POST",
                "url": "{{countriesGraphqlUrl}}",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "query CountryByCode($code: ID!) {\n  country(code: $code) {\n    name\n    capital\n    languages {\n      name\n    }\n  }\n}",
                  "variables": {
                    "code": "JP"
                  }
                }
              }
            },
            {
              "type": "request",
              "name": "Several operations — pick one by name",
              "config": {
                "method": "POST",
                "url": "{{countriesGraphqlUrl}}",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "query Continents {\n  continents {\n    code\n    name\n  }\n}\n\nquery Languages {\n  languages {\n    code\n    name\n  }\n}",
                  "operationName": "Continents"
                }
              }
            },
            {
              "type": "request",
              "name": "Nested fields and filters",
              "config": {
                "method": "POST",
                "url": "{{countriesGraphqlUrl}}",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "query EuropeanCountries($continent: String!) {\n  countries(filter: { continent: { eq: $continent } }) {\n    code\n    name\n    continent {\n      name\n    }\n  }\n}",
                  "variables": {
                    "continent": "EU"
                  }
                }
              }
            },
            {
              "type": "request",
              "name": "Error response (unknown field)",
              "config": {
                "method": "POST",
                "url": "{{countriesGraphqlUrl}}",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "{\n  country(code: \"IN\") {\n    name\n    population\n  }\n}"
                }
              }
            }
          ]
        },
        {
          "name": "Rick and Morty API",
          "folders": [],
          "items": [
            {
              "type": "request",
              "name": "Paginated list with variables",
              "config": {
                "method": "POST",
                "url": "https://rickandmortyapi.com/graphql",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "query Characters($page: Int, $name: String) {\n  characters(page: $page, filter: { name: $name }) {\n    info {\n      count\n      pages\n      next\n    }\n    results {\n      id\n      name\n      status\n      species\n    }\n  }\n}",
                  "variables": {
                    "page": 1,
                    "name": "rick"
                  }
                },
                "testScript": "jt.test(\"found characters\", () => {\n  jt.expect(jt.response.json().data.characters.results.length).toBeGreaterThan(0);\n});"
              }
            },
            {
              "type": "request",
              "name": "Single item by id",
              "config": {
                "method": "POST",
                "url": "https://rickandmortyapi.com/graphql",
                "params": [],
                "headers": [],
                "body": {
                  "mode": "none"
                },
                "auth": {
                  "type": "none"
                },
                "protocol": "graphql",
                "protocolConfig": {
                  "query": "query Character($id: ID!) {\n  character(id: $id) {\n    name\n    origin {\n      name\n    }\n    episode {\n      name\n      air_date\n    }\n  }\n}",
                  "variables": {
                    "id": "1"
                  }
                }
              }
            }
          ]
        }
      ],
