              "serviceFullName": "hello.HelloService",
              "methodName": "SayHello",
              "requestMessage": {
                "greeting": "reflection"
              },
              "usePlaintext": true,
              "source": "reflection"
            }
          }
        }
      ]
    },
    {
      "category": "api",
      "name": "Sample — SOAP",
      "folders": [],
      "items": [
        {
          "type": "request",
          "name": "Add two numbers (SOAP 1.1)",
          "config": {
            "method": "POST",
            "url": "http://www.dneonline.com/calculator.asmx",
            "params": [],
            "headers": [],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <Add xmlns=\"http://tempuri.org/\">\n      <intA>2</intA>\n      <intB>3</intB>\n    </Add>\n  </soap:Body>\n</soap:Envelope>"
            },
            "auth": {
              "type": "none"
            },
            "protocol": "soap",
            "protocolConfig": {
              "version": "1.1",
              "action": "http://tempuri.org/Add"
            },
            "testScript": "jt.test(\"2 + 3 = 5\", () => jt.expect(jt.response.body).toContain(\"<AddResult>5</AddResult>\"));"
          }
        },
        {
          "type": "request",
          "name": "Multiply (SOAP 1.2)",
          "config": {
            "method": "POST",
            "url": "http://www.dneonline.com/calculator.asmx",
            "params": [],
            "headers": [],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap12:Envelope xmlns:soap12=\"http://www.w3.org/2003/05/soap-envelope\">\n  <soap12:Body>\n    <Multiply xmlns=\"http://tempuri.org/\">\n      <intA>{{postId}}</intA>\n      <intB>7</intB>\n    </Multiply>\n  </soap12:Body>\n</soap12:Envelope>"
            },
            "auth": {
              "type": "none"
            },
            "protocol": "soap",
            "protocolConfig": {
              "version": "1.2",
              "action": "http://tempuri.org/Multiply"
            }
          }
        },
        {
          "type": "request",
          "name": "A fault (divide by zero)",
          "config": {
            "method": "POST",
            "url": "http://www.dneonline.com/calculator.asmx",
            "params": [],
            "headers": [],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <Divide xmlns=\"http://tempuri.org/\">\n      <intA>1</intA>\n      <intB>0</intB>\n    </Divide>\n  </soap:Body>\n</soap:Envelope>"
            },
            "auth": {
              "type": "none"
            },
            "protocol": "soap",
            "protocolConfig": {
              "version": "1.1",
              "action": "http://tempuri.org/Divide"
            },
            "testScript": "jt.test(\"the service faults\", () => jt.expect(jt.response.status).toBe(500));"
          }
        }
      ]
    },
    {
      "category": "websocket",
      "name": "Sample — WebSocket",
      "folders": [
        {
          "name": "With headers and auth",
          "folders": [],
          "items": [
            {
              "type": "websocket",
              "name": "Echo with custom headers",
              "url": "wss://echo.websocket.org",
              "headers": [
                {
                  "key": "X-Client",
                  "value": "jtaak-sample",
                  "enabled": true
                }
              ],
              "subprotocols": [],
              "auth": {
                "type": "none"
              }
            },
            {
              "type": "websocket",
              "name": "Echo with a bearer token",
              "url": "wss://echo.websocket.org",
              "headers": [],
              "subprotocols": [],
              "auth": {
                "type": "bearer",
                "bearer": {
                  "token": "sample-token"
                }
              }
            }
          ]
        }
      ],
      "items": [
        {
          "type": "websocket",
          "name": "Echo server",
          "url": "wss://echo.websocket.org",
          "headers": [],
          "subprotocols": [],
          "auth": {
            "type": "none"
          }
        },
        {
          "type": "websocket",
          "name": "Postman echo server",
          "url": "wss://ws.postman-echo.com/raw",
          "headers": [],
          "subprotocols": [],
          "auth": {
            "type": "none"
          }
        },
        {
          "type": "websocket",
          "name": "Echo via {{wsEchoUrl}}, with tests",
          "url": "{{wsEchoUrl}}",
          "headers": [],
          "subprotocols": [],
          "auth": {
            "type": "none"
          },
          "testScript": "// Connect, send a message: the tests run again as messages arrive.\njt.test(\"something comes back\", () => {\n  jt.expect(jt.messages.some((m) => m.direction === \"received\")).toBe(true);\n});\njt.test(\"what's sent is echoed\", () => {\n  const sent = jt.messages.filter((m) => m.direction === \"sent\").map((m) => m.data);\n  const received = jt.messages.filter((m) => m.direction === \"received\").map((m) => m.data);\n  jt.expect(sent.every((text) => received.includes(text))).toBe(true);\n});"
        }
      ]
    },
