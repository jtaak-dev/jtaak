{
  "name": "@jtaak/engine",
  "version": "0.5.0",
  "description": "Local-first API request engine: HTTP, GraphQL, Server-Sent Events, gRPC, WebSocket and MCP, with scripting, collections, import and export, and SQLite storage.",
  "keywords": [
    "api",
    "http",
    "graphql",
    "grpc",
    "websocket",
    "sse",
    "mcp",
    "api-client",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Jana Software Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtaak-dev/jtaak.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/jtaak-dev/jtaak#readme",
  "bugs": {
    "url": "https://github.com/jtaak-dev/jtaak/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check:pack": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "better-sqlite3": "^13.0.3",
    "mqtt": "^5.16.0",
    "protobufjs": "^8.8.0",
    "quickjs-emscripten-core": "^0.32.0",
    "socket.io-client": "^4.8.4",
    "undici": "^7.30.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.1",
    "aedes": "^1.2.0",
    "node-forge": "^1.4.0",
    "publint": "^0.3.24",
    "socket.io": "^4.8.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
