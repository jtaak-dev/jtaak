{
  "name": "jtaak",
  "version": "0.11.0",
  "description": "Command-line API client on the jtaak engine: send HTTP requests from the terminal with `jt`.",
  "keywords": [
    "api",
    "http",
    "cli",
    "api-client",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Jana Software Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtaak-dev/jtaak.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jtaak-dev/jtaak#readme",
  "bugs": {
    "url": "https://github.com/jtaak-dev/jtaak/issues"
  },
  "type": "module",
  "bin": {
    "jt": "./dist/index.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "check:pack": "publint",
    "check:install": "node scripts/check-install.mjs"
  },
  "dependencies": {
    "@jtaak/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "publint": "^0.3.24",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
